# Title:
#    No Class Should Be Outside the BFO Hierarchy
# Constraint Description:
#     All classes must have a BFO superclass.
# Severity:
#     Error
#
# A valid ontology should return ZERO rows: every owl:Class must have some
# ancestor (via rdfs:subClassOf*) whose IRI lives in the BFO namespace.

PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?class ?error
WHERE {
  ?class a owl:Class .
  FILTER (!isBlank(?class))
  FILTER NOT EXISTS {
    ?class rdfs:subClassOf* ?ancestor .
    FILTER (STRSTARTS(STR(?ancestor), "http://purl.obolibrary.org/obo/BFO_"))
  }
  BIND (concat("ERROR: Class ", str(?class), " has no BFO superclass in its subClassOf hierarchy.") AS ?error)
}
ORDER BY ?class
