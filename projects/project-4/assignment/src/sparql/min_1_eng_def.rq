# Title:
#    Definition Required
# Constraint Description:
#    Any class or object property must have a non-empty definition with an English language tag.
# Severity:
#     Warning
#
# A valid ontology should return ZERO rows.

PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?element ?error
WHERE {
  { ?element a owl:Class } UNION { ?element a owl:ObjectProperty }
  FILTER (!isBlank(?element))
  FILTER NOT EXISTS {
    ?element skos:definition ?def .
    FILTER (lang(?def) = "en" && STRLEN(STR(?def)) > 0)
  }
  BIND (concat("WARNING: ", str(?element), " has no non-empty English skos:definition.") AS ?error)
}
ORDER BY ?element
