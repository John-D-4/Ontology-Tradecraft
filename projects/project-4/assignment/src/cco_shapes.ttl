@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix ex:   <http://example.org/shapes/> .

# checks are looking for this file in the wrong spot, so i guess i'll duplicate into the parent of shacl/
#################################################################
# 1) Artifact bears at least one SDC (cardinality)
#################################################################
ex:ArtifactHasSDCShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00000995 ;                 # Material Artifact
  sh:property [
    sh:path obo:BFO_0000196 ;                       # bearer of
    sh:minCount 1 ;
    sh:class obo:BFO_0000020 ;                      # specifically dependent continuant
    sh:message "Every Artifact must bear at least one SDC (Specifically Dependent Continuant)." ;
    sh:severity sh:Violation
  ] .

#################################################################
# 2) SDC is measured by at least one MICE (coverage via inverse)
#################################################################
ex:SDCMeasuredBySomeMICEShape
  a sh:NodeShape ;
  sh:targetClass obo:BFO_0000020 ;                  # specifically dependent continuant
  sh:property [
    sh:path [ sh:inversePath cco:ont00001966 ] ;     # inverse of "is a measurement of"
    sh:minCount 1 ;
    sh:class cco:ont00001163 ;                       # Measurement Information Content Entity
    sh:message "Every SDC must be measured by at least one MICE." ;
    sh:severity sh:Violation
  ] .

#################################################################
# 3) MICE measures exactly one SDC (functional)
#################################################################
ex:MICEMeasuresExactlyOneSDCShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00001163 ;                  # Measurement Information Content Entity
  sh:property [
    sh:path cco:ont00001966 ;                        # is a measurement of
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class obo:BFO_0000020 ;
    sh:message "Every MICE must be a measurement of exactly one SDC." ;
    sh:severity sh:Violation
  ] .

#################################################################
# 4) MICE must have one unit and one numeric value (completeness)
#################################################################
ex:MICEHasUnitAndValueShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00001163 ;
  sh:property [
    sh:path cco:ont00001863 ;                        # uses measurement unit
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class cco:ont00000120 ;                       # Measurement Unit
    sh:message "Every MICE must use exactly one Measurement Unit." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path cco:ont00001769 ;                        # has decimal value
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:message "Every MICE must have exactly one decimal value." ;
    sh:severity sh:Violation
  ] .

#################################################################
# 5) No empty values in literals
#################################################################
ex:NoEmptyLiteralsShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00000120 ;                  # Measurement Unit
  sh:property [
    sh:path cco:ont00001765 ;                        # has text value
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:message "Every Measurement Unit must carry a non-empty text value (unit label)." ;
    sh:severity sh:Violation
  ] .

#################################################################
# 6) Unit must match SDC being measured
#################################################################
# Every SDC and every Measurement Unit is tagged (skos:altLabel) with its
# quantity kind (e.g. "temperature", "pressure"). A MICE's Measurement Unit
# must belong to the same quantity kind as the SDC it measures -- e.g. a
# temperature SDC must not be measured using a voltage unit. This is
# tolerant of legitimate unit variation within a kind (e.g. "C" vs "F").
ex:UnitMatchesSDCKindShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00001163 ;                  # Measurement Information Content Entity
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A MICE's Measurement Unit must belong to the same quantity kind as the SDC it measures." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX cco:  <https://www.commoncoreontologies.org/>
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT $this ?sdcKind ?unitKind
      WHERE {
        $this cco:ont00001966 ?sdc ; cco:ont00001863 ?unit .
        ?sdc skos:altLabel ?sdcKind .
        ?unit skos:altLabel ?unitKind .
        FILTER (?sdcKind != ?unitKind)
      }
    """ ;
  ] .

#################################################################
# 7) No duplicate MICE
#################################################################
# No two distinct MICE instances may record the same SDC, unit, value, and
# timestamp -- that would be a duplicate measurement record.
ex:NoDuplicateMICEShape
  a sh:NodeShape ;
  sh:targetClass cco:ont00001163 ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "No two MICE may record the same SDC, unit, value, and timestamp (duplicate measurement)." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX cco: <https://www.commoncoreontologies.org/>
      SELECT $this
      WHERE {
        $this cco:ont00001966 ?sdc ; cco:ont00001863 ?u ; cco:ont00001769 ?v ; cco:ont00001767 ?t .
        ?other cco:ont00001966 ?sdc ; cco:ont00001863 ?u ; cco:ont00001769 ?v ; cco:ont00001767 ?t .
        FILTER (?other != $this)
      }
    """ ;
  ] .

#################################################################
# 8) No dangling/mistyped nodes
#################################################################
# Every node reachable via bearer_of, is_measure_of, or uses_measurement_unit
# must itself carry an explicit rdf:type (i.e. no dangling/untyped nodes).
ex:NoDanglingReferencedNodesShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX cco: <https://www.commoncoreontologies.org/>
      PREFIX obo: <http://purl.obolibrary.org/obo/>
      SELECT ?this
      WHERE {
        { ?x obo:BFO_0000196 ?this } UNION
        { ?x cco:ont00001966 ?this } UNION
        { ?x cco:ont00001863 ?this }
      }
    """ ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:minCount 1 ;
    sh:message "Every node referenced via bearer_of, is_measure_of, or uses_measurement_unit must be explicitly typed." ;
    sh:severity sh:Violation
  ] .
